# Optional: the Connect Wyze dialog (or `python app.py login`) fills these in for you.
WYZE_EMAIL=you@example.com
WYZE_PASSWORD=your-password
# From https://developer-api-console.wyze.com/#/apikey/view
WYZE_KEY_ID=your-key-id
WYZE_API_KEY=your-api-key
# Optional: authenticator-app secret for fully automatic TOTP 2FA re-login.
WYZE_TOTP_KEY=
# Optional: max seconds per Wyze request.
WYZE_TIMEOUT_SECONDS=15

APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
