WYZE_EMAIL=you@example.com
WYZE_PASSWORD=your-password
WYZE_KEY_ID=your-key-id
WYZE_API_KEY=your-api-key
# Optional: used when your account has TOTP 2FA.
WYZE_TOTP_KEY=
# Optional: max seconds per Wyze request.
WYZE_TIMEOUT_SECONDS=15
# Optional: skip fragile device-list call and query known scale models directly.
WYZE_SKIP_SCALE_LIST=true

APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
