# Optional: the app fills these in when you connect. Secrets (password, API key,
# tokens) are kept in your system credential store, not in this file.
WYZE_EMAIL=you@example.com
WYZE_KEY_ID=your-key-id
# Optional: max seconds per Wyze request.
WYZE_TIMEOUT_SECONDS=15

APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
